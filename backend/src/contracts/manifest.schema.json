{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["app", "screens", "version"],
  "properties": {
    "version": { "type": "string" },
    "app": {
      "type": "object",
      "required": ["id", "name", "theme"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "theme": { "type": "object" }
      }
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/widgetScreen" }
    }
  },
  "definitions": {
    "widgetScreen": {
      "type": "object",
      "required": ["id", "title", "root"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "root": { "$ref": "#/definitions/widgetNode" }
      }
    },
    "widgetNode": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string" },
        "props": { "type": "object" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/definitions/widgetNode" }
        },
        "child": { "$ref": "#/definitions/widgetNode" },
        "itemTemplate": { "$ref": "#/definitions/widgetNode" }
      }
    }
  }
}
